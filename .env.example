# Public site settings — exposed to client bundles. All vars must be prefixed PUBLIC_.

# WhatsApp phone, digits only (country code + number, no + or spaces).
PUBLIC_CONTACT_WHATSAPP=34600000000

# Contact email shown in the footer and on the thank-you page.
PUBLIC_CONTACT_EMAIL=hello@spaceforedu.com

# Absolute site URL (used for canonical links and hreflang alternates).
PUBLIC_SITE_URL=https://spaceforedu.com

# Feature flag: when "true", shows the Dashboard preview / "included features" sections.
# Any other value (including unset) keeps these sections hidden.
PUBLIC_FEATURE_DASHBOARD=false

# Google Tag Manager container ID (e.g. GTM-XXXXXXX).
# Leave empty to disable GTM entirely (safe for local dev).
PUBLIC_GTM_ID=

# Social profiles — used in Organization schema (sameAs) for Google trust.
# Leave empty until the profiles are created.
PUBLIC_SOCIAL_FACEBOOK=
PUBLIC_SOCIAL_YOUTUBE=
PUBLIC_SOCIAL_LINKEDIN=
PUBLIC_SOCIAL_TELEGRAM=
PUBLIC_SOCIAL_TWITTER=
PUBLIC_SOCIAL_GOOGLE_BUSINESS=

# ---------------------------------------------------------------------------
# Pagos con Stripe
# ---------------------------------------------------------------------------
# TODAS estas variables son PUBLICAS por diseno y van en el HTML servido.
# La clave SECRETA (sk_...) NO debe aparecer nunca aqui ni en el repositorio.

# Clave publicable de la cuenta: Stripe -> Desarrolladores -> Claves API.
PUBLIC_STRIPE_PUBLISHABLE_KEY=

# ID de cada Buy Button: Stripe -> Productos -> el producto -> Buy button.
# Con la clave publicable puesta, el boton se incrusta EN la pagina y abre el
# checkout encima, sin sacar al visitante a otra pestana.
PUBLIC_STRIPE_BUY_BUTTON_500=
PUBLIC_STRIPE_BUY_BUTTON_100=

# Alternativa mas simple: Payment Links. Si no hay Buy Button, los CTA usan
# estos enlaces; si tampoco estan, caen a la pagina de precios.
# Al crearlos, configurar el success_url con el session_id, que es lo que
# permite al webhook cruzar el pago con el lead:
#   https://spaceforedu.com/es/gracias-homologacion/?session_id={CHECKOUT_SESSION_ID}
#   https://spaceforedu.com/es/gracias-consulta/?session_id={CHECKOUT_SESSION_ID}
PUBLIC_STRIPE_LINK_BACHILLERATO_500=
PUBLIC_STRIPE_LINK_CONSULTA_100=

# ---------------------------------------------------------------------------
# Agenda de citas
# ---------------------------------------------------------------------------
# URL de reservas de Google Calendar -> Programaciones de citas.
# Requiere Google Workspace de pago; con Gmail personal la funcion es limitada.
# El calendario NO se carga al abrir la pagina: se muestra un aviso y el iframe
# solo se inserta si el visitante pulsa, para no poner cookies de Google antes
# de que decida nada.
PUBLIC_CALENDAR_BOOKING_URL=

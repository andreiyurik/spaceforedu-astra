---
import "@/styles/global.css";
import ClientRouter from "astro/components/ClientRouter.astro";
import JsonLd from "@/components/common/JsonLd.astro";
import LanguageSwitcher from "@/components/common/LanguageSwitcher.astro";
import GtmHead from "@/components/common/GtmHead.astro";
import GtmBody from "@/components/common/GtmBody.astro";
import { type Locale } from "@/lib/constants";
import { publicRoute, publicPages } from "@/lib/routes";
import { getMessages, makeT } from "@/lib/i18n";
import { organization } from "@/lib/structured-data";
import interTightLatin from "@fontsource-variable/inter-tight/files/inter-tight-latin-wght-normal.woff2?url";
import interLatin from "@fontsource-variable/inter/files/inter-latin-wght-normal.woff2?url";
import interTightCyrillic from "@fontsource-variable/inter-tight/files/inter-tight-cyrillic-wght-normal.woff2?url";
import interCyrillic from "@fontsource-variable/inter/files/inter-cyrillic-wght-normal.woff2?url";

interface Props {
  title: string;
  description?: string;
  locale: Locale;
  /** LCP image preloaded with high priority. Path under /public. */
  heroImage?: string;
}

const { title, description = "", locale, heroImage } = Astro.props;
const currentPath = Astro.url.pathname;
const t = makeT(getMessages(locale));
const skipLabel = t("a11y.skip_to_content");
const homeHref = publicRoute(publicPages.home, locale);
const year = new Date().getFullYear();
// Preload the font subset that matches the page language (Cyrillic on /ru/) to
// avoid a flash of fallback text on non-Latin locales.
const useCyrillic = locale === "ru";
const interTightFont = useCyrillic ? interTightCyrillic : interTightLatin;
const interFont = useCyrillic ? interCyrillic : interLatin;
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <ClientRouter />

    {/* Ad landing — keep out of the index so it never competes with the SEO page. */}
    <meta name="robots" content="noindex,follow" />
    <meta name="author" content="Space for Edu" />

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Space for Edu" />

    <link rel="preload" as="font" href={interTightFont} type="font/woff2" crossorigin="anonymous" />
    <link rel="preload" as="font" href={interFont} type="font/woff2" crossorigin="anonymous" />
    {heroImage && (
      <link rel="preload" as="image" href={heroImage} type="image/webp" fetchpriority="high" media="(min-width: 768px)" />
    )}

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#E8453C" />

    <JsonLd data={organization()} />
    <slot name="structured-data" />
    <GtmHead />
  </head>
  <body class="min-h-screen bg-background text-foreground antialiased">
    <GtmBody />
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:top-2 focus:left-2 focus:z-[60] focus:rounded-md focus:bg-foreground focus:px-4 focus:py-2 focus:text-sm focus:font-medium focus:text-background"
    >
      {skipLabel}
    </a>

    <div class="flex min-h-screen flex-col pb-[calc(72px+env(safe-area-inset-bottom))] lg:pb-0">
      {/* Minimal header: brand + language only — no nav to keep one path to action. */}
      <header class="relative w-full border-b border-[var(--hairline-soft)] bg-white/96 backdrop-blur">
        {locale === "es" && (
          <div aria-hidden="true" class="absolute inset-x-0 bottom-[-4px] flex h-1 pointer-events-none">
            <span class="flex-[1] bg-[var(--primary)]"></span>
            <span class="flex-[2] bg-[#F1BF00]"></span>
            <span class="flex-[1] bg-[var(--primary)]"></span>
          </div>
        )}
        <div class="mx-auto flex h-16 max-w-7xl items-center px-4 sm:px-6 lg:px-8">
          <a href={homeHref} class="flex shrink-0 items-center">
            <span class="font-display text-[20px] font-bold tracking-[-0.02em] text-[var(--ink-soft)]">
              Space for <span class="text-[var(--primary-pressed)]">Edu</span>
            </span>
          </a>
          <div class="ml-auto">
            <LanguageSwitcher locale={locale} currentPath={currentPath} />
          </div>
        </div>
      </header>

      <main id="main" class="flex-1 overflow-x-clip">
        <slot />
      </main>

      {/* Slim legal footer — no link maze. */}
      <footer class="border-t border-[var(--hairline-soft)] bg-white">
        <div class="mx-auto flex max-w-7xl flex-col items-center justify-between gap-3 px-4 py-6 text-[13px] text-[var(--ash)] sm:flex-row sm:px-6 lg:px-8">
          <span>© {year} Space for Edu</span>
          <div class="flex items-center gap-5">
            <a href={publicRoute(publicPages.privacyPolicy, locale)} class="hover:text-[var(--body-color)]">
              {t("footer.privacy")}
            </a>
            <a href={publicRoute(publicPages.legalNotice, locale)} class="hover:text-[var(--body-color)]">
              {t("footer.legal_notice")}
            </a>
          </div>
        </div>
      </footer>
    </div>

    <script>
      import Lenis from "lenis";
      let lenis: Lenis | null = null;
      let rafId: number | null = null;
      function initLenis() {
        if (rafId != null) cancelAnimationFrame(rafId);
        lenis?.destroy();
        lenis = null;
        rafId = null;
        if (window.matchMedia("(hover: none)").matches) return;
        if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;
        lenis = new Lenis({ duration: 1.15, easing: (t) => 1 - Math.pow(1 - t, 4) });
        function raf(time: number) {
          lenis!.raf(time);
          rafId = requestAnimationFrame(raf);
        }
        rafId = requestAnimationFrame(raf);
      }
      document.addEventListener("astro:page-load", initLenis);
    </script>
  </body>
</html>

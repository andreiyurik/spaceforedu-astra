---
import PublicLayout from "@/layouts/PublicLayout.astro";
import { Button } from "@/components/ui/button";
import { getMessages, makeT } from "@/lib/i18n";
import { DEFAULT_LOCALE, LOCALES, type Locale } from "@/lib/constants";
import { publicRoute, publicPages } from "@/lib/routes";

// Cloudflare Pages serves /404.html for any unknown path. Copy defaults to
// the primary locale (es) — users landing here from any route see Spanish,
// which matches our primary market.
const locale = DEFAULT_LOCALE;
const messages = getMessages(locale);
const t = makeT(messages);
const homeHref = publicRoute(publicPages.home, locale);

// El 404 se sirve desde /404.html, sin prefijo de idioma. El conmutador, al no
// encontrar prefijo, generaba /es/404/, /en/404/ y /ru/404/, que no existen:
// desde un 404 se llegaba a otro 404. Ahora cada idioma va a su portada.
// Un 404 que solo ofrece "volver al inicio" desperdicia la visita: quien llega
// aqui venia buscando algo concreto. Estos son los destinos reales del sitio.
const destinos = [
  { href: publicRoute(publicPages.homologacion, locale), key: "l_homologacion" },
  { href: publicRoute(publicPages.guias, locale), key: "l_guias" },
  { href: publicRoute(publicPages.universidad, locale), key: "l_universidad" },
  { href: publicRoute(publicPages.espanol, locale), key: "l_espanol" },
  { href: publicRoute(publicPages.precios, locale), key: "l_precios" },
  { href: publicRoute(publicPages.blog, locale), key: "l_blog" },
];

const localeHrefs = Object.fromEntries(
  LOCALES.map((l) => [l, publicRoute(publicPages.home, l)]),
) as Partial<Record<Locale, string>>;
---

<PublicLayout
  title={`${t("public.not_found.title")} — Space for Edu`}
  description={t("public.not_found.desc")}
  locale={locale}
  page=""
  hideStickyCta
  noindex
  localeHrefs={localeHrefs}
>
  <section class="flex flex-col items-center justify-center text-center px-4 py-24 sm:py-40 min-h-[60vh] bg-[var(--surface-soft)]">
    <p class="text-xs font-semibold uppercase tracking-[0.12em] text-[var(--accent-blue-deep)] mb-4">
      {t("public.not_found.eyebrow")}
    </p>
    <h1 class="font-display text-4xl sm:text-6xl font-semibold tracking-[-0.03em] text-[var(--ink)] max-w-2xl">
      {t("public.not_found.title")}
    </h1>
    <p class="mt-6 text-lg text-[var(--mute)] max-w-md">
      {t("public.not_found.desc")}
    </p>
    <a href={homeHref} class="mt-10">
      <Button
        size="lg"
        className="min-h-[44px] h-12 px-6 text-[15px] font-bold bg-[var(--primary)] hover:bg-[var(--primary-pressed)] text-white border-0"
      >
        {t("public.not_found.cta")}
      </Button>
    </a>

    <nav class="mt-14 w-full max-w-2xl" aria-labelledby="destinos-404">
      <h2
        id="destinos-404"
        class="text-[13px] font-semibold uppercase tracking-[0.1em] text-[var(--ash)] mb-5"
      >
        {t("public.not_found.ayuda")}
      </h2>
      <ul class="grid gap-2 sm:grid-cols-2 text-left">
        {
          destinos.map(({ href, key }) => (
            <li>
              <a
                href={href}
                data-cta="404-destino"
                class="block rounded-lg border border-[var(--hairline-soft)] bg-[var(--surface-elevated)] px-4 py-3 text-[15px] font-semibold text-[var(--ink)] hover:border-[var(--primary)] transition-colors"
              >
                {t(`public.not_found.${key}`)}
              </a>
            </li>
          ))
        }
      </ul>
      <p class="mt-6 text-[13px] text-[var(--ash)]">
        {t("public.not_found.escribenos")}
      </p>
    </nav>
  </section>
</PublicLayout>

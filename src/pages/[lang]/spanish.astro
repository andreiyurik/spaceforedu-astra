---
import PublicLayout from "@/layouts/PublicLayout.astro";
import JsonLd from "@/components/common/JsonLd.astro";
import Container from "@/components/public/Container.astro";
import Reveal from "@/components/public/Reveal.astro";
import Counter from "@/components/public/Counter.astro";
import LucideIcon from "@/components/common/LucideIcon.astro";
import PublicHero from "@/components/public/PublicHero.astro";
import PinSectionHead from "@/components/public/pin/PinSectionHead.astro";
import PinServicesCard from "@/components/public/pin/PinServicesCard.astro";
import TimelineSection from "@/components/public/TimelineSection.astro";
import FaqSection from "@/components/public/FaqSection.astro";
import CrossSellCard from "@/components/public/CrossSellCard.astro";
import PinFinalCta from "@/components/public/pin/PinFinalCta.astro";
import { ConsultationDialogButton } from "@/components/public/ConsultationDialog";
import { getMessages, makeT } from "@/lib/i18n";
import { getSeo } from "@/lib/seo";
import { LOCALES, assertLocale } from "@/lib/constants";
import { publicRoute, publicPages } from "@/lib/routes";
import { service, faqPage, breadcrumbList } from "@/lib/structured-data";
import { buildConsultationStrings } from "@/lib/consultation";
import { setupServiceHero } from "@/lib/service-hero";
import heroSrc from "@/assets/images/services/espanol/students-spanish-class-focused.webp";

export function getStaticPaths() {
  return LOCALES.map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params;
const locale = assertLocale(lang);
const messages = getMessages(locale);
const t = makeT(messages);
const seo = getSeo("espanol", locale);

const E = "public.espanol";

const serviceLd = service({
  locale,
  name: seo.title,
  description: seo.description,
  page: publicPages.espanol,
  serviceType: "Spanish language course",
  audience: "International students and professionals learning Spanish in Spain or online",
});
const faqLd = faqPage(messages, E);
const breadcrumbLd = breadcrumbList(locale, t("nav.espanol"), publicPages.espanol);

const { heroAvif, heroWebp } = await setupServiceHero(heroSrc);
const heroSizes = "(min-width: 1024px) 40vw, 90vw";
const preciosHref = publicRoute(publicPages.precios, locale) + "#plans";
const consultationStrings = buildConsultationStrings(t);

const FORMATS = [
  { iconName: "user", key: "individual" },
  { iconName: "users", key: "group" },
  { iconName: "trending-up", key: "intensive" },
];

const LEVELS = [
  { level: "A1–A2", iconName: "book-open", key: "beginner" },
  { level: "B1–B2", iconName: "briefcase", key: "intermediate" },
  { level: "C1–C2", iconName: "award", key: "advanced" },
];

const ADVANTAGES = [
  { iconName: "languages", title: t(`${E}.adv_native_title`), desc: t(`${E}.adv_native_desc`) },
  { iconName: "graduation-cap", title: t(`${E}.adv_dele_title`), desc: t(`${E}.adv_dele_desc`) },
  { iconName: "brain", title: t(`${E}.adv_method_title`), desc: t(`${E}.adv_method_desc`) },
  { iconName: "calendar-check", title: t(`${E}.adv_flexible_title`), desc: t(`${E}.adv_flexible_desc`) },
];

const HERO_STATS = [
  { value: "100+", key: "students" },
  { value: "A1–C2", key: "levels" },
  { value: "3", key: "formats" },
];

const PROOF = [
  { value: 100, suffix: "+", key: "students" },
  { value: 85, suffix: "%", key: "dele" },
  { value: 4, suffix: "", key: "months" },
  { value: 15, suffix: "+", key: "years" },
];
---

<PublicLayout
  title={seo.title}
  description={seo.description}
  locale={locale}
  page={publicPages.espanol}
  heroImage={heroWebp.src}
  heroImageType="image/webp"
  heroImageSrcset={heroWebp.srcSet?.attribute}
  heroImageAvifSrcset={heroAvif.srcSet?.attribute}
  heroImageSizes={heroSizes}
  heroPreloadMedia="all"
>
  <JsonLd slot="structured-data" data={serviceLd} />
  <JsonLd slot="structured-data" data={breadcrumbLd} />
  {faqLd && <JsonLd slot="structured-data" data={faqLd} />}

  <PublicHero fullBleed title1={t(`${E}.hero_title_1`)} titleAccent={t(`${E}.hero_title_accent`)}>
    <span slot="subtitle" set:html={t(`${E}.hero_subtitle`)} />

    <div slot="actions" class="flex flex-col sm:flex-row gap-3">
      <ConsultationDialogButton
        client:visible
        strings={consultationStrings}
        triggerLabel={t(`${E}.cta_trial`)}
        triggerClass="pin-btn pin-btn-primary h-12 px-6 text-[15px] w-full sm:w-auto"
      />
      <a href={preciosHref} class="pin-btn pin-btn-secondary h-12 px-6 text-[15px] w-full sm:w-auto">
        {t(`${E}.cta_pricing`)}
      </a>
    </div>

    <div slot="footer" class="grid grid-cols-3 gap-6 pt-8 mt-4 border-t border-[var(--hairline-soft)] max-w-[460px]">
      {HERO_STATS.map(({ value, key }) => (
        <div>
          <div class="font-display text-[26px] sm:text-[32px] font-bold text-[var(--ink)] tracking-[-0.03em] leading-none">
            {value}
          </div>
          <div class="text-[13px] text-[var(--mute)] mt-1.5 leading-tight">{t(`${E}.hero_stat_${key}`)}</div>
        </div>
      ))}
    </div>

    <div slot="illustration" class="photo-frame">
      <picture>
        {heroAvif.srcSet?.attribute && (
          <source type="image/avif" srcset={heroAvif.srcSet.attribute} sizes={heroSizes} />
        )}
        <img
          src={heroWebp.src}
          srcset={heroWebp.srcSet?.attribute}
          sizes={heroSizes}
          alt={t(`${E}.hero_img_alt`)}
          width={heroSrc.width}
          height={heroSrc.height}
          loading="eager"
          fetchpriority="high"
          decoding="async"
          class="w-full object-cover aspect-[4/3]"
        />
      </picture>
    </div>
  </PublicHero>

  {/* ── Formats ── */}
  <section class="py-16 sm:py-20 bg-white">
    <Container>
      <PinSectionHead
        title1={t(`${E}.pin_formats_title_1`)}
        accent={t(`${E}.pin_formats_title_accent`)}
        sub={t(`${E}.formats_subtitle`)}
      />
      <div class="grid gap-4 sm:grid-cols-3">
        {FORMATS.map(({ iconName, key }, i) => (
          <PinServicesCard
            iconName={iconName}
            title={t(`${E}.format_${key}_title`)}
            desc={t(`${E}.format_${key}_desc`)}
            meta={t(`${E}.format_${key}_note`)}
            delay={i * 80}
          />
        ))}
      </div>
    </Container>
  </section>

  {/* ── Journey / levels ── */}
  <section class="py-16 sm:py-20 bg-[var(--surface-soft)]">
    <Container>
      <PinSectionHead
        title1={t(`${E}.pin_journey_title_1`)}
        accent={t(`${E}.pin_journey_title_accent`)}
        sub={t(`${E}.journey_subtitle`)}
      />
      <div class="grid gap-4 sm:grid-cols-3">
        {LEVELS.map(({ level, iconName, key }, i) => (
          <Reveal direction="up" delay={i * 80}>
            <div class="flex h-full flex-col gap-3.5 rounded-2xl border border-[var(--hairline-soft)] bg-white p-7">
              <div class="flex items-center justify-between">
                <span class="font-display text-[28px] font-bold leading-none tracking-[-0.02em] text-[var(--primary)]">
                  {level}
                </span>
                <div class="flex h-11 w-11 items-center justify-center rounded-2xl bg-[var(--surface-card)] text-[var(--primary)]">
                  <LucideIcon name={iconName} class="h-5 w-5" />
                </div>
              </div>
              <h3 class="m-0 text-[20px] font-semibold tracking-[-0.01em] text-[var(--ink)]">
                {t(`${E}.journey_${key}_label`)}
              </h3>
              <ul class="m-0 flex flex-1 list-none flex-col gap-2.5 p-0">
                {[1, 2, 3].map((j) => (
                  <li class="flex items-start gap-2.5">
                    <LucideIcon name="check" class="mt-0.5 h-4 w-4 shrink-0 text-[#22a655]" />
                    <span class="text-[14px] leading-[1.5] text-[var(--mute)]">{t(`${E}.journey_${key}_${j}`)}</span>
                  </li>
                ))}
              </ul>
              <p class="m-0 border-t border-[var(--hairline-soft)] pt-3.5 text-[13px] font-medium text-[var(--ash)]">
                {t(`${E}.journey_${key}_time`)}
              </p>
            </div>
          </Reveal>
        ))}
      </div>
    </Container>
  </section>

  {/* ── Steps ── */}
  <section class="py-16 sm:py-20 bg-white">
    <Container>
      <PinSectionHead
        title1={t(`${E}.pin_steps_title_1`)}
        accent={t(`${E}.pin_steps_title_accent`)}
        sub={t(`${E}.steps_subtitle`)}
      />
      <TimelineSection translationPrefix={E} t={t} count={4} keyPattern="step" />
    </Container>
  </section>

  {/* ── Advantages ── */}
  <section class="py-16 sm:py-20 bg-[var(--surface-soft)]">
    <Container>
      <PinSectionHead
        title1={t(`${E}.pin_adv_title_1`)}
        accent={t(`${E}.pin_adv_title_accent`)}
        sub={t(`${E}.adv_subtitle`)}
      />
      <div class="grid gap-x-10 gap-y-12 sm:grid-cols-2 lg:grid-cols-4">
        {ADVANTAGES.map(({ iconName, title, desc }, i) => (
          <Reveal direction="up" delay={i * 90}>
            <div>
              <LucideIcon name={iconName} class="h-8 w-8 text-[var(--primary)]" strokeWidth={1.6} />
              <h3 class="mt-5 font-display text-[19px] font-bold leading-[1.25] tracking-[-0.01em] text-[var(--ink)]">
                {title}
              </h3>
              <p class="mt-2.5 text-[15px] leading-[1.6] text-[var(--mute)]">{desc}</p>
            </div>
          </Reveal>
        ))}
      </div>
    </Container>
  </section>

  {/* ── Proof ── */}
  <section class="py-16 sm:py-20 bg-white">
    <Container>
      <PinSectionHead
        title1={t(`${E}.pin_proof_title_1`)}
        accent={t(`${E}.pin_proof_title_accent`)}
        sub={t(`${E}.proof_subtitle`)}
      />
      <div class="grid grid-cols-2 gap-8 lg:grid-cols-4">
        {PROOF.map(({ value, suffix, key }, i) => (
          <Reveal direction="up" delay={i * 80}>
            <div>
              <div class="font-display text-[40px] sm:text-[48px] font-bold leading-none tracking-[-0.03em] text-[var(--ink)]">
                <Counter value={value} suffix={suffix} />
              </div>
              <p class="mt-2.5 text-[14px] leading-[1.4] text-[var(--mute)]">{t(`${E}.proof_${key}`)}</p>
            </div>
          </Reveal>
        ))}
      </div>
    </Container>
  </section>

  <CrossSellCard
    title={t(`${E}.crosssell_title`)}
    description={t(`${E}.crosssell_desc`)}
    links={[
      { label: t(`${E}.crosssell_homologacion`), href: publicRoute(publicPages.homologacion, locale) },
      { label: t(`${E}.crosssell_universidad`), href: publicRoute(publicPages.universidad, locale) },
    ]}
    badgeLabel={t(`${E}.crosssell_badge`)}
    badgeIconName="house"
  />

  {/* ── FAQ ── */}
  <section class="py-16 sm:py-20 bg-white">
    <Container>
      <PinSectionHead
        title1={t(`${E}.pin_faq_title_1`)}
        accent={t(`${E}.pin_faq_title_accent`)}
        sub={t(`${E}.pin_faq_sub`)}
        align="center"
      />
      <FaqSection translationPrefix={E} t={t} messages={messages} />
    </Container>
  </section>

  <PinFinalCta
    prefix={E}
    t={t}
    consultationStrings={consultationStrings}
    bgImage="/images/lifestyle/spain-flag-waving-blue-sky.webp"
    sideItemCount={5}
  />
</PublicLayout>

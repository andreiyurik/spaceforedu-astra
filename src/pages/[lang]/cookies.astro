---
import PublicLayout from "@/layouts/PublicLayout.astro";
import { getMessages, makeT } from "@/lib/i18n";
import { getSeo } from "@/lib/seo";
import { LOCALES, assertLocale } from "@/lib/constants";
import { publicPages } from "@/lib/routes";

export function getStaticPaths() {
  return LOCALES.map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params;
const locale = assertLocale(lang);
const messages = getMessages(locale);
const t = makeT(messages);
const seo = getSeo("cookies", locale);

const sections = ["what", "usage", "thirdparty", "manage"] as const;
---

<PublicLayout
  title={seo.title}
  description={seo.description}
  locale={locale}
  page={publicPages.cookies}
  hideStickyCta
>
  <div class="mx-auto max-w-2xl space-y-8 px-4 py-16 sm:py-24">
    <h1 class="text-3xl font-bold tracking-tight">{t("public.cookies.title")}</h1>

    <p class="text-sm text-muted-foreground leading-relaxed">
      {t("public.cookies.intro")}
    </p>

    {
      sections.map((key) => (
        <section class="space-y-3">
          <h2 class="text-lg font-semibold">
            {t(`public.cookies.${key}_title`)}
          </h2>
          <p class="text-sm text-muted-foreground leading-relaxed">
            {t(`public.cookies.${key}_body`)}
          </p>
        </section>
      ))
    }

    <button
      type="button"
      id="cookie-reopen"
      class="inline-flex items-center min-h-[44px] px-5 rounded-lg text-sm font-semibold border border-[var(--hairline)] text-[var(--ink)] hover:bg-[var(--surface-card)] transition-colors"
    >
      {t("public.cookie_banner.manage")}
    </button>
  </div>

  <script is:inline>
    document.getElementById("cookie-reopen")?.addEventListener("click", () => {
      if (typeof window.spaceForEduOpenConsent === "function") {
        window.spaceForEduOpenConsent();
      }
    });
  </script>
</PublicLayout>

---
import PublicLayout from "@/layouts/PublicLayout.astro";
import JsonLd from "@/components/common/JsonLd.astro";
import Container from "@/components/public/Container.astro";
import Reveal from "@/components/public/Reveal.astro";
import Counter from "@/components/public/Counter.astro";
import LucideIcon from "@/components/common/LucideIcon.astro";
import { ConsultationDialogButton } from "@/components/public/ConsultationDialog";
import UniversityLogoBar from "@/components/public/UniversityLogoBar.astro";
import PinComparison from "@/components/public/pin/PinComparison.astro";
import PinFinalCta from "@/components/public/pin/PinFinalCta.astro";
import { getMessages, makeT } from "@/lib/i18n";
import { getSeo } from "@/lib/seo";
import { LOCALES, assertLocale } from "@/lib/constants";
import { publicRoute, publicPages } from "@/lib/routes";
import { website, serviceList } from "@/lib/structured-data";
import { buildConsultationStrings } from "@/lib/consultation";
import { setupServiceHero } from "@/lib/service-hero";
import heroSrc from "@/assets/images/hero/hero-student-salamanca-docs.webp";

export function getStaticPaths() {
  return LOCALES.map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params;
const locale = assertLocale(lang);
const messages = getMessages(locale);
const t = makeT(messages);
const seo = getSeo("home", locale);

const H = "public.home";
const { heroAvif, heroWebp } = await setupServiceHero(heroSrc);
const heroSizes = "(min-width: 1024px) 40vw, 50vw";
const pricingHref = publicRoute(publicPages.precios, locale) + "#plans";
const consultationStrings = buildConsultationStrings(t);

/** Split a stat string like "1700+" / "98%" into an animatable number + suffix. */
function parseStat(raw: string): { num: number; suffix: string } {
  const m = raw.match(/^(\d[\d\s.,]*)(.*)$/);
  if (!m) return { num: 0, suffix: raw };
  return { num: parseInt(m[1].replace(/[\s.,]/g, ""), 10), suffix: m[2] };
}

const services = [
  { iconName: "file-check", title: t(`${H}.service_homologacion_title`), desc: t(`${H}.pin_service_homologation_desc`), href: publicRoute(publicPages.homologacion, locale) },
  { iconName: "graduation-cap", title: t(`${H}.service_universidad_title`), desc: t(`${H}.pin_service_university_desc`), href: publicRoute(publicPages.universidad, locale) },
  { iconName: "languages", title: t(`${H}.service_espanol_title`), desc: t(`${H}.pin_service_spanish_desc`), href: publicRoute(publicPages.espanol, locale) },
];

const stats = [1, 2, 3].map((n) => ({
  ...parseStat(t(`${H}.pin_hero_stat_${n}_value`)),
  label: t(`${H}.pin_hero_stat_${n}_label`),
}));

const risk = [
  { iconName: "shield-check", title: t(`${H}.pin_risk_item_1_title`), desc: t(`${H}.pin_risk_item_1_desc`) },
  { iconName: "hand-coins", title: t(`${H}.pin_risk_item_2_title`), desc: t(`${H}.pin_risk_item_2_desc`) },
  { iconName: "file-check", title: t(`${H}.pin_risk_item_3_title`), desc: t(`${H}.pin_risk_item_3_desc`) },
];

const serviceArrowLabel = t(`${H}.pin_service_arrow`).replace(/\s*→\s*$/, "");

const TILE = "position:absolute;border-radius:28px;overflow:hidden;box-shadow:0 2px 4px rgba(38,34,30,0.05), 0 22px 44px -24px rgba(38,34,30,0.32);";
const tileImg = (op = "center") => `width:100%;height:100%;object-fit:cover;object-position:${op};`;
---

<PublicLayout
  title={seo.title}
  description={seo.description}
  locale={locale}
  page=""
  heroImage={heroWebp.src}
  heroImageType="image/webp"
  heroImageSrcset={heroWebp.srcSet?.attribute}
  heroImageAvifSrcset={heroAvif.srcSet?.attribute}
  heroImageSizes={heroSizes}
>
  <JsonLd slot="structured-data" data={website()} />
  <JsonLd slot="structured-data" data={serviceList(locale)} />

  {/* ── Hero ── */}
  <section class="bg-[var(--surface-soft)] overflow-hidden">
    <Container class="pt-12 pb-10 sm:pt-16 sm:pb-12 lg:pt-20">
      <div class="grid items-center gap-10 lg:grid-cols-[1.1fr_0.9fr] lg:gap-16">
        <div>
          <Reveal direction="up">
            <span class="t-eyebrow">{t(`${H}.pin_hero_eyebrow`)}</span>
          </Reveal>
          <Reveal direction="up" delay={60}>
            <h1 class="mt-4 font-display font-semibold tracking-[-0.025em] text-[var(--ink)] text-[38px] leading-[1.04] sm:text-[52px] lg:text-[60px]">
              {t(`${H}.pin_hero_title_1`)}{" "}
              <span class="text-[var(--primary)]">{t(`${H}.pin_hero_title_accent`)}</span>
            </h1>
          </Reveal>
          <Reveal direction="up" delay={120}>
            <p class="mt-6 max-w-[520px] text-[18px] leading-[1.55] text-[var(--mute)]">
              {t(`${H}.pin_hero_subtitle`)}
            </p>
          </Reveal>
          <Reveal direction="up" delay={180}>
            <div class="mt-8 flex flex-col gap-3">
              <div class="flex flex-wrap items-center gap-3">
                <ConsultationDialogButton
                  client:visible
                  strings={consultationStrings}
                  triggerLabel={t(`${H}.hero_cta_consult`)}
                  arrow
                  triggerClass="group inline-flex h-14 items-center justify-center gap-2.5 rounded-full bg-[var(--charcoal)] px-8 text-[16px] font-bold text-white shadow-[0_12px_30px_-12px_rgba(38,34,30,0.55)] transition-all duration-200 hover:-translate-y-0.5 hover:bg-[var(--ink)] hover:shadow-[0_18px_40px_-14px_rgba(38,34,30,0.6)] active:translate-y-0"
                />
                <a
                  href={pricingHref}
                  class="inline-flex h-14 items-center justify-center gap-2 rounded-full border border-[var(--hairline)] bg-white px-7 text-[16px] font-bold text-[var(--ink)] transition-all hover:-translate-y-0.5 hover:bg-[var(--surface-card)] hover:shadow-[0_10px_24px_-12px_rgba(38,34,30,0.25)]"
                >
                  {t(`${H}.pin_hero_cta_secondary`)}
                </a>
              </div>
              <span class="pl-1 text-[13px] text-[var(--mute)]">{t(`${H}.pin_hero_reassure`)}</span>
            </div>
          </Reveal>

          <Reveal direction="up" delay={240}>
            <div class="mt-10 grid max-w-[460px] grid-cols-3 gap-4 border-t border-[var(--hairline-soft)] pt-7">
              {stats.map(({ num, suffix, label }) => (
                <div>
                  <div class="font-display text-[28px] font-bold leading-none tracking-[-0.03em] text-[var(--ink)]">
                    <Counter value={num} suffix={suffix} />
                  </div>
                  <div class="mt-2 text-[12px] leading-[1.3] text-[var(--mute)]">{label}</div>
                </div>
              ))}
            </div>
          </Reveal>
        </div>

        {/* Art-directed collage — inline styles survive View-Transition swaps. */}
        <Reveal direction="left" delay={120}>
          <div style="position:relative;width:100%;max-width:500px;margin-inline:auto;aspect-ratio:10 / 11;">
            <div class="hero-tile" style={`${TILE}top:0;right:0;height:64%;width:64%;`}>
              <img
                src={heroWebp.src}
                srcset={heroWebp.srcSet?.attribute}
                sizes="(min-width: 1024px) 30vw, 60vw"
                alt={t(`${H}.hero_img_alt`)}
                width={heroSrc.width}
                height={heroSrc.height}
                loading="eager"
                class="anim-kenburns"
                style={tileImg("60% 30%")}
              />
            </div>
            <div class="hero-tile" style={`${TILE}bottom:0;right:14%;height:38%;width:46%;`}>
              <img src="/images/lifestyle/spain-flag-waving-blue-sky.webp" alt="Spanish flag waving against a clear blue sky" loading="lazy" style={tileImg()} />
            </div>
            <div class="hero-tile" style={`${TILE}bottom:8%;left:0;height:42%;width:38%;`}>
              <img src="/images/lifestyle/madrid-almudena-sunset.webp" alt="Almudena Cathedral and the Royal Palace of Madrid at sunset" loading="lazy" style={tileImg()} />
            </div>
            <div
              class="flex flex-col items-center justify-center p-3 text-center"
              style="position:absolute;top:16%;left:0;height:30%;width:31%;border-radius:24px;background:#f4e9d7;box-shadow:0 2px 4px rgba(38,34,30,0.05);"
            >
              <span class="font-display text-[30px] sm:text-[38px] font-bold leading-none tracking-[-0.03em] text-[var(--primary)]">
                {t(`${H}.pin_hero_badge_years`)}
              </span>
              <span class="mt-1.5 text-[10px] sm:text-[11px] font-medium leading-tight text-[var(--mute)]">
                {t(`${H}.pin_hero_badge_years_label`)}
              </span>
            </div>
          </div>
        </Reveal>
      </div>
    </Container>
  </section>

  <UniversityLogoBar t={t} titleKey={`${H}.logo_bar_title`} />

  {/* ── Three services ── */}
  <section class="bg-white">
    <Container class="py-16 sm:py-24">
      <Reveal direction="up">
        <h2 class="max-w-[640px] font-display text-[32px] sm:text-[44px] font-bold tracking-[-0.02em] leading-[1.1] text-[var(--ink)]">
          {t(`${H}.pin_services_title_1`)}{" "}
          <span class="text-[var(--primary)]">{t(`${H}.pin_services_title_accent`)}</span>
        </h2>
        <p class="mt-4 max-w-[560px] text-[17px] leading-[1.6] text-[var(--mute)]">
          {t(`${H}.pin_services_sub`)}
        </p>
      </Reveal>
      <div class="mt-12 grid gap-6 sm:grid-cols-3">
        {services.map(({ iconName, title, desc, href }, i) => (
          <Reveal direction="up" delay={i * 90}>
            <a
              href={href}
              class="group flex h-full flex-col rounded-[28px] border border-[var(--hairline-soft)] bg-[var(--surface-soft)] p-8 transition-all duration-300 hover:-translate-y-1 hover:border-[var(--hairline)] hover:bg-white hover:shadow-[0_24px_48px_-28px_rgba(38,34,30,0.35)]"
            >
              <LucideIcon name={iconName} class="h-8 w-8 text-[var(--primary)]" strokeWidth={1.6} />
              <h3 class="mt-6 font-display text-[21px] font-bold tracking-[-0.01em] text-[var(--ink)]">{title}</h3>
              <p class="mt-3 flex-1 text-[15px] leading-[1.6] text-[var(--mute)]">{desc}</p>
              <span class="mt-6 inline-flex items-center gap-1.5 text-[14px] font-bold text-[var(--primary)]">
                {serviceArrowLabel}
                <LucideIcon name="arrow-right" class="h-4 w-4 transition-transform group-hover:translate-x-1" />
              </span>
            </a>
          </Reveal>
        ))}
      </div>
    </Container>
  </section>

  {/* ── Honest comparison ── */}
  <PinComparison prefix={H} t={t} rowCount={5} />

  {/* ── Risk reversal ── */}
  <section class="bg-white">
    <Container class="py-16 sm:py-24">
      <Reveal direction="up">
        <h2 class="font-display text-[32px] sm:text-[44px] font-bold tracking-[-0.02em] leading-[1.1] text-[var(--ink)]">
          {t(`${H}.pin_risk_title_1`)}{" "}
          <span class="text-[var(--primary)]">{t(`${H}.pin_risk_title_accent`)}</span>
        </h2>
      </Reveal>
      <div class="mt-12 grid gap-x-10 gap-y-12 sm:grid-cols-3">
        {risk.map(({ iconName, title, desc }, i) => (
          <Reveal direction="up" delay={i * 90}>
            <div>
              <LucideIcon name={iconName} class="h-8 w-8 text-[var(--primary)]" strokeWidth={1.6} />
              <h3 class="mt-5 font-display text-[19px] font-bold leading-[1.25] tracking-[-0.01em] text-[var(--ink)]">{title}</h3>
              <p class="mt-2.5 text-[15px] leading-[1.6] text-[var(--mute)]">{desc}</p>
            </div>
          </Reveal>
        ))}
      </div>
    </Container>
  </section>

  {/* ── Reach ── */}
  <section class="bg-white">
    <Container class="py-16 sm:py-20">
      <div class="flex flex-col items-start gap-6 sm:flex-row sm:items-center sm:gap-12">
        <LucideIcon name="globe-2" class="h-12 w-12 shrink-0 text-[var(--primary)]" strokeWidth={1.4} />
        <div>
          <span class="t-eyebrow">{t(`${H}.pin_reach_eyebrow`)}</span>
          <h2 class="mt-3 font-display text-[26px] sm:text-[32px] font-bold leading-[1.15] tracking-[-0.015em] text-[var(--ink)]">
            {t(`${H}.pin_reach_title_1`)}{" "}
            <span class="text-[var(--primary)]">{t(`${H}.pin_reach_title_accent`)}</span>{" "}
            {t(`${H}.pin_reach_title_2`)}
          </h2>
          <p class="mt-3 max-w-[680px] text-[15px] leading-[1.6] text-[var(--mute)]">
            {t(`${H}.pin_reach_sub`)}
          </p>
        </div>
      </div>
    </Container>
  </section>

  <PinFinalCta prefix={H} t={t} consultationStrings={consultationStrings} sideItemCount={5} />
</PublicLayout>

---
import LpLayout from "@/layouts/LpLayout.astro";
import { LpHomologacionPage } from "@/components/pages/LpHomologacion";
import { getMessages, makeT } from "@/lib/i18n";
import { getSeo } from "@/lib/seo";
import { LOCALES, CONTACT_WHATSAPP, assertLocale } from "@/lib/constants";
import { whatsappLink } from "@/lib/routes";

export function getStaticPaths() {
  return LOCALES.map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params;
const locale = assertLocale(lang);
const messages = getMessages(locale);
const t = makeT(messages);

// La landing recibia el objeto `messages` ENTERO. Astro serializa los props de
// cada isla dentro del HTML, asi que eso metia 113 KB —el 78 % de la pagina—
// en las paginas a las que se paga por clic. El componente solo lee dos
// espacios de nombres: public.homologacion y lp.hom.
const lpMessages = {
  public: { homologacion: messages.public.homologacion },
  lp: { hom: messages.lp.hom },
};
const seo = getSeo("homologacion", locale);

const heroImage = "/images/hero/hero-student-salamanca-docs.webp";
const waHref = CONTACT_WHATSAPP
  ? whatsappLink(CONTACT_WHATSAPP, t("lp.hom.wa_message"))
  : "#";
---

<LpLayout title={seo.title} description={seo.description} locale={locale} heroImage={heroImage}>
  <LpHomologacionPage client:load locale={locale} messages={lpMessages} waHref={waHref} />
</LpLayout>

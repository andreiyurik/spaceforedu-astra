---
// Static twin of <SectionHeading> from shared.tsx.
import { cn } from "@/lib/utils";
import Reveal from "@/components/public/Reveal.astro";
interface Props {
  title: string;
  subtitle?: string;
  align?: "center" | "left";
}
const { title, subtitle, align = "center" } = Astro.props;
---

<div class={cn("mb-12 sm:mb-16 max-w-2xl", align === "center" && "mx-auto text-center")}>
  <Reveal direction="up">
    <h2 class="font-display text-3xl sm:text-4xl font-bold tracking-tight text-[var(--ink)]">
      {title}
    </h2>
    {subtitle && <p class="mt-4 text-lg text-muted-foreground">{subtitle}</p>}
  </Reveal>
</div>

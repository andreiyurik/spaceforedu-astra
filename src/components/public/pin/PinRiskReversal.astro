---
// Static twin of PinRiskReversal.tsx.
import Reveal from "@/components/public/Reveal.astro";
import Container from "@/components/public/Container.astro";
import LucideIcon from "@/components/common/LucideIcon.astro";

interface RiskItem {
  iconName: string;
  n: number;
}
interface Props {
  prefix: string;
  t: (key: string) => string;
  items: readonly RiskItem[];
  background?: "soft" | "white";
}
const { prefix, t, items, background = "soft" } = Astro.props;
const sectionBg = background === "white" ? "bg-white" : "bg-[var(--surface-soft)]";
---

<section class={`py-12 sm:py-16 ${sectionBg}`}>
  <Container>
    <Reveal direction="up">
      <div class="bg-white rounded-[32px] p-8 sm:p-12 border border-[var(--hairline-soft)] grid gap-10 lg:grid-cols-[1fr_1.3fr] lg:items-center">
        <h3 class="font-display text-[28px] sm:text-[36px] font-bold tracking-[-0.025em] leading-[1.1] text-[var(--ink)] m-0">
          {t(`${prefix}.pin_risk_title_1`)}{" "}
          <span class="text-[var(--primary)]">
            {t(`${prefix}.pin_risk_title_accent`)}
          </span>
        </h3>
        <div class="flex flex-col gap-3.5">
          {items.map(({ iconName, n }) => (
            <div class="flex gap-3.5 items-start">
              <div class="w-9 h-9 rounded-2xl bg-[var(--success-pale)] text-[var(--success-deep)] flex items-center justify-center shrink-0">
                <LucideIcon name={iconName} class="h-4 w-4" strokeWidth={2.5} />
              </div>
              <div>
                <h4 class="text-[15px] font-bold text-[var(--ink)] m-0 mb-1">
                  {t(`${prefix}.pin_risk_item_${n}_title`)}
                </h4>
                <p class="text-[14px] leading-[1.45] text-[var(--mute)] m-0">
                  {t(`${prefix}.pin_risk_item_${n}_desc`)}
                </p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </Reveal>
  </Container>
</section>

---
// Static twin of TimelineSection.tsx.
import Reveal from "@/components/public/Reveal.astro";

interface Props {
  translationPrefix: string;
  count: number;
  keyPattern?: string;
  t: (key: string) => string;
}
const { translationPrefix, count, keyPattern = "process", t } = Astro.props;
const steps = Array.from({ length: count }, (_, i) => i);
---

<div class="max-w-2xl mx-auto">
  {steps.map((i) => {
    const isLast = i === count - 1;
    return (
      <Reveal direction="up" delay={i * 120}>
        <div class="flex gap-5 sm:gap-8 items-stretch">
          <div class="flex flex-col items-center shrink-0 w-12 sm:w-14">
            <div
              aria-hidden="true"
              class="font-display text-4xl sm:text-5xl font-bold tracking-[-0.025em] leading-none text-[var(--primary)] select-none"
            >
              {String(i + 1).padStart(2, "0")}
            </div>
            {!isLast && (
              <div class="mt-3 w-px flex-1 bg-[var(--hairline)]" aria-hidden="true" />
            )}
          </div>
          <div class={`flex-1 ${isLast ? "" : "pb-10 sm:pb-12"}`}>
            <h3 class="text-base sm:text-lg font-semibold tracking-tight">
              {t(`${translationPrefix}.${keyPattern}_${i + 1}_title`)}
            </h3>
            <p class="text-sm sm:text-[15px] text-muted-foreground leading-relaxed mt-1.5">
              {t(`${translationPrefix}.${keyPattern}_${i + 1}_desc`)}
            </p>
          </div>
        </div>
      </Reveal>
    );
  })}
</div>

---
// Static twin of FaqSection.tsx. Count is derived from the i18n bundle so the
// rendered list and the FAQPage JSON-LD can never drift apart.
import Reveal from "@/components/public/Reveal.astro";
import { countFaq, type Messages } from "@/lib/i18n";

interface Props {
  translationPrefix: string;
  t: (key: string) => string;
  messages: Messages;
}
const { translationPrefix, t, messages } = Astro.props;
const items = Array.from({ length: countFaq(messages, translationPrefix) }, (_, i) => i);
---

<Reveal direction="up" delay={100}>
  <div class="max-w-2xl mx-auto divide-y divide-[var(--hairline-soft)]">
    {items.map((i) => (
      <details class="group py-4 [&_summary::-webkit-details-marker]:hidden">
        <summary class="flex items-start justify-between gap-4 cursor-pointer list-none text-left text-[15px] font-semibold text-[var(--ink)] hover:text-[var(--primary)] transition-colors min-h-[44px]">
          <span>{t(`${translationPrefix}.faq_${i + 1}_q`)}</span>
          <svg
            aria-hidden="true"
            viewBox="0 0 24 24"
            class="h-5 w-5 shrink-0 mt-0.5 text-[var(--mute)] transition-transform group-open:rotate-180"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <path d="m6 9 6 6 6-6" />
          </svg>
        </summary>
        <div class="mt-3 text-[14px] leading-relaxed text-[var(--mute)]">
          {t(`${translationPrefix}.faq_${i + 1}_a`)}
        </div>
      </details>
    ))}
  </div>
</Reveal>
